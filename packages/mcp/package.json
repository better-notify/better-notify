{
  "name": "@betternotify/mcp",
  "version": "0.0.0-beta.3",
  "description": "Model Context Protocol (MCP) server for Better-Notify — expose your notification catalog as AI agent tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/better-notify/better-notify",
    "directory": "packages/mcp"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "NODE_OPTIONS='--import tsx/esm' rolldown -c",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@betternotify/core": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@internal/rolldown-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "engines": {
    "node": ">=22"
  }
}
